object MetaCognition {
    private val thoughtLog = CircularBuffer<String>(capacity = 100)
    
    fun think(step: String, details: String) {
        val timestamp = SimpleDateFormat("HH:mm:ss", Locale.getDefault()).format(Date())
        val entry = "[$timestamp] $step: $details"
        thoughtLog.add(entry)
        
        // Persist periodically for dashboard visualization
        if(thoughtLog.size % 10 == 0) saveThoughtLogToDisk()
    }
    
    fun getRecentThoughts(count: Int = 10): List<String> {
        return thoughtLog.toList().takeLast(count)
    }
    
    fun assessCapability(request: String): CapabilityAssessment {
        val knownCapabilities = setOf("web_search", "app_control", "calendar", "messaging", "ar_vision", "file_management")
        val requiredCapability = inferRequiredCapability(request)
        
        val canDo = knownCapabilities.contains(requiredCapability)
        val confidence = if(canDo) 0.95 else 0.0
        
        return CapabilityAssessment(
            canFulfill = canDo,
            requiredSkill = requiredCapability,
            alternativeSuggestion = if(!canDo) suggestAlternative(request) else null,
            honestyStatement = generateHonestyStatement(request, canDo)
        )
    }
    
    private fun generateHonestyStatement(request: String, canDo: Boolean): String {
        return if(canDo) {
            "I can definitely help with that using my ${inferRequiredCapability(request)} module."
        } else {
            "I want to be transparent: I don't currently have the ability to ${request.take(50)}. " +
            "However, I can ${suggestAlternative(request)}. Would that work instead?"
        }
    }
}

data class CapabilityAssessment(
    val canFulfill: Boolean,
    val requiredSkill: String,
    val alternativeSuggestion: String?,
    val honestyStatement: String
)
