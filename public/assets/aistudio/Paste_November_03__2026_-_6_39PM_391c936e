// Phase 10 Bridge Methods

@JavascriptInterface fun enableAiInterop(enabled: Boolean) {
    AiInteropBridge.isEnabled = enabled
}

@JavascriptInterface fun saveExternalKeys(keysJson: String) {
    val keys = JSONObject(keysJson)
    NovaPrefs.p(act).edit()
        .putString("openai_key", keys.optString("openai"))
        .putString("anthropic_key", keys.optString("anthropic"))
        .apply()
}

@JavascriptInterface fun executeAiDag(dagJson: String): String {
    val dag = parseDagFromJson(dagJson)
    val results = runBlocking { AiInteropBridge.executeDag(dag) }
    return JSONObject(results).toString()
}

@JavascriptInterface fun getRecentThoughts(): String {
    return JSONArray(MetaCognition.getRecentThoughts()).toString()
}

@JavascriptInterface fun startTranslator(source: String, target: String) {
    UniversalTranslator.startEarbudMode(source, target)
}

@JavascriptInterface fun assessCapability(request: String): String {
    val assessment = MetaCognition.assessCapability(request)
    return JSONObject()
        .put("can_fulfill", assessment.canFulfill)
        .put("skill", assessment.requiredSkill)
        .put("statement", assessment.honestyStatement)
        .toString()
}
