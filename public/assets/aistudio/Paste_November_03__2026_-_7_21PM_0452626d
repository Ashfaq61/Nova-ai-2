const cv=$('orb'),cx=cv.getContext('2d');
let W,H,DPR=Math.min(window.devicePixelRatio||1,2);

function sizeCanvas(){
  const rect=cv.getBoundingClientRect();
  W=rect.width*DPR;H=rect.height*DPR;
  cv.width=W;cv.height=H;
}
sizeCanvas();
window.addEventListener('resize',sizeCanvas);

const NP=300,P=[];
for(let i=0;i<NP;i++){
  const a=Math.random()*Math.PI*2,r=.32+Math.random()*.16;
  P.push({ang:a,rad:r,spd:(Math.random()-.5)*.0009,size:1+Math.random()*2.4,ph:Math.random()*6.28});
}

let STATE='idle',energy=0,targetEnergy=0,mood={r:124,g:92,b:255};
const MOODS={idle:[124,92,255],listen:[0,224,255],think:[255,61,139],talk:[0,255,163]};

function setState(s,label,colorDot){
  STATE=s;$('stlabel').textContent=label;
  $('wrap').classList.toggle('talk',s==='talk'||s==='listen');
  $('sdot').style.background=colorDot;$('sdot').style.boxShadow=`0 0 12px ${colorDot}`;
  mood=MOODS[s]||MOODS.idle;
}

(function sim(){targetEnergy=.06+.05*Math.abs(Math.sin(Date.now()/900));})();

let t=0;
function frame(){
  requestAnimationFrame(frame);t++;
  energy+=(targetEnergy-energy)*.12;
  
  const centerX=W/2,centerY=H/2,R=Math.min(W,H)*.34;
  cx.clearRect(0,0,W,H);

  const g=cx.createRadialGradient(centerX,centerY,0,centerX,centerY,R*(1+energy*1.4));
  g.addColorStop(0,`rgba(${mood.r},${mood.g},${mood.b},.9)`);
  g.addColorStop(.4,`rgba(${mood.r},${mood.g},${mood.b},.35)`);
  g.addColorStop(1,'rgba(0,0,0,0)');
  cx.fillStyle=g;cx.beginPath();cx.arc(centerX,centerY,R*(1+energy*1.4),0,Math.PI*2);cx.fill();

  cx.beginPath();
  for(let i=0;i<=120;i++){
    const a=i/120*Math.PI*2;
    const wob=Math.sin(a*3+t*.04)*energy*R*.18+Math.sin(a*5-t*.03)*R*.04;
    const rr=R+wob;
    const x=centerX+Math.cos(a)*rr,y=centerY+Math.sin(a)*rr;
    i?cx.lineTo(x,y):cx.moveTo(x,y);
  }
  cx.closePath();
  cx.strokeStyle=`rgba(${mood.r},${mood.g},${mood.b},.5)`;cx.lineWidth=1.5*DPR;cx.stroke();

  for(const p of P){
    p.ang+=p.spd*(1+energy*8);
    const pr=R*p.rad*(1+energy*.9)+Math.sin(t*.05+p.ph)*4*DPR;
    const x=centerX+Math.cos(p.ang)*pr,y=centerY+Math.sin(p.ang)*pr;
    const al=.35+energy*.65;
    cx.fillStyle=`rgba(${mood.r},${mood.g},${mood.b},${al})`;
    cx.beginPath();cx.arc(x,y,p.size*DPR*(1+energy),0,Math.PI*2);cx.fill();
  }
  
  cx.fillStyle=`rgba(255,255,255,${.5+energy*.5})`;
  cx.beginPath();cx.arc(centerX,centerY,R*.12*(1+energy*.5),0,Math.PI*2);cx.fill();
}
frame();

